\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}CPU utilization}{4}{subsection.1.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.3.1}Whole-host CPU with blocking disabled}{4}{subsubsection.1.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Whole-host CPU with blocking disabled: userspace above and kernel below. Percentages refer to all cores, and the vertical scales differ.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:cpu-host-unblk}{{4}{4}{Whole-host CPU with blocking disabled: userspace above and kernel below. Percentages refer to all cores, and the vertical scales differ}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.3.2}Whole-host CPU with blocking enabled}{5}{subsubsection.1.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Whole-host CPU with blocking enabled: userspace above and kernel below. Most packets are intentionally dropped, leaving low sustained CPU use with intermittent bursts.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:cpu-host-blk}{{5}{5}{Whole-host CPU with blocking enabled: userspace above and kernel below. Most packets are intentionally dropped, leaving low sustained CPU use with intermittent bursts}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Counter-weighted host CPU utilization. The approximate high-rate phase uses samples ending between 850 and 1575~s on each recording's local clock. Whole-recording values include startup and quiet traffic.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:cpu}{{2}{5}{Counter-weighted host CPU utilization. The approximate high-rate phase uses samples ending between 850 and 1575~s on each recording's local clock. Whole-recording values include startup and quiet traffic}{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.3.3}Detector-process CPU}{6}{subsubsection.1.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Detector-process CPU with blocking disabled: userspace above and kernel below. Each percentage uses one core as the denominator. XDP work is outside the kernel detector process, and the vertical scales differ substantially.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cpu-process-unblk}{{6}{6}{Detector-process CPU with blocking disabled: userspace above and kernel below. Each percentage uses one core as the denominator. XDP work is outside the kernel detector process, and the vertical scales differ substantially}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Detector-process CPU with blocking enabled: userspace above and kernel below. Sustained utilization is low; the userspace process still experiences short bursts when traffic reaches its capture and counting path.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cpu-process-blk}{{7}{7}{Detector-process CPU with blocking enabled: userspace above and kernel below. Sustained utilization is low; the userspace process still experiences short bursts when traffic reaches its capture and counting path}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Throughput and packet accounting}{8}{subsection.1.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Observed counted traffic with blocking disabled. Mbps uses decimal frame-byte rates. Sustained intervals are selected independently, rather than aligned between recordings.}}{8}{table.caption.10}\protected@file@percent }
\newlabel{tab:throughput}{{3}{8}{Observed counted traffic with blocking disabled. Mbps uses decimal frame-byte rates. Sustained intervals are selected independently, rather than aligned between recordings}{table.caption.10}{}}
