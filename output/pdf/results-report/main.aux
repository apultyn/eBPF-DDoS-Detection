\newlabel{fig:local-latency}{{8}{9}{Local timing in the four resource recordings, using evaluated windows with \texttt {warm\_up=false}. Circles show medians and end markers show the 95th percentiles. The two panels use different horizontal scales}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Local timing over each individual recording after the recorded detector warm-up. Nanosecond timestamps are subtracted as integers before conversion to milliseconds.}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:latency}{{4}{9}{Local timing over each individual recording after the recorded detector warm-up. Nanosecond timestamps are subtracted as integers before conversion to milliseconds}{table.caption.12}{}}
