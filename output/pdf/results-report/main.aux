\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Provisional userspace window-label evaluation. The top panel shows dataset-derived truth, the middle panel shows detector verdicts, and the lower strip distinguishes TP, TN, FP and FN outcomes.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:accuracy-user}{{9}{10}{Provisional userspace window-label evaluation. The top panel shows dataset-derived truth, the middle panel shows detector verdicts, and the lower strip distinguishes TP, TN, FP and FN outcomes}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Saved provisional scores for \texttt  {eval-usr-acc-gen-1} and \texttt  {eval-ker-acc-gen-1}. Each scores 4,393 windows, including 4,160 attack-labelled and 233 benign-labelled windows.}}{10}{table.caption.14}\protected@file@percent }
\newlabel{tab:accuracy}{{5}{10}{Saved provisional scores for \texttt {eval-usr-acc-gen-1} and \texttt {eval-ker-acc-gen-1}. Each scores 4,393 windows, including 4,160 attack-labelled and 233 benign-labelled windows}{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Provisional kernel window-label evaluation, with the same panel definitions as Figure~\ref {fig:accuracy-user}. Similar patterns are descriptive and do not establish equivalent detection performance.}}{11}{figure.caption.15}\protected@file@percent }
